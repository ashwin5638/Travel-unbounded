# Environment variables
# Copy this file to .env.local and fill in the values

# MongoDB Atlas connection string
ATLAS_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=...

# Auth.js secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=...

# Admin credentials (used by seed script)
ADMIN_EMAIL=admin@travelunbounded.com
ADMIN_PASSWORD=admin123
